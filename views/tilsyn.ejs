<%- include('partials/head', { title: 'Brand tilsyn' }) %>
<%
  const isDashboard = view === 'dashboard';
  const number = (value) => new Intl.NumberFormat('da-DK').format(value);
  const date = (iso, opts = { day: 'numeric', month: 'short', year: 'numeric' }) => iso ? new Date(iso).toLocaleDateString('da-DK', { ...opts, timeZone: 'UTC' }) : '—';
  const ago = (days) => days == null ? '' : days === 0 ? 'i dag' : days === 1 ? 'i går' : days < 60 ? days + ' dage siden' : Math.round(days / 30.4) + ' mdr. siden';
  const listHref = '/tilsyn?view=liste';
  const filterHref = (params) => listHref + '&' + Object.entries(params).map(([key, value]) => key + '=' + encodeURIComponent(value)).join('&');
  const percent = (value, max) => max ? Math.max(2, Math.round(value / max * 100)) : 0;
  const bucketClass = { under3: 'pb-c1', '3til6': 'pb-c0', '6til12': 'pb-c2', over12: 'pb-c3' };
  const options = (key) => [...new Set(inspections.map(item => item[key]).filter(Boolean))].sort((a, b) => String(a).localeCompare(String(b), 'da'));
%>
<body class="app-shell">
  <%- include('partials/sidebar', { user, settings, currentPath }) %>
  <main class="main-content">
    <header class="topbar"><div class="breadcrumb">Cibus <span>/</span> <a href="/tilsyn">Brand tilsyn</a> <span>/</span> <strong><%= viewNav.activeSection %></strong></div><div class="topbar-date"><span class="status-dot"></span> <%= source ? 'Tilsynsark opdateret ' + new Date(source.modifiedAt).toLocaleString('da-DK', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Tilsynsregistrering' %></div></header>
    <section class="page-content">
      <div class="page-heading-row"><div><p class="eyebrow">BRAND TILSYN · CIBUS REAL ESTATE</p><h1>Brand tilsyn</h1><p class="page-subtitle">Registrering af tilsyn med Cibus' ejendomme: seneste og forrige tilsyn pr. ejendom, og hvor længe siden ejendommen er tilset. Data læses fra tilsynsarket<%= source ? ' "' + source.fileName + '"' : '' %> og kan ikke ændres her.</p></div><span class="mode-badge live"><span></span>Excel · <%= number(inspections.length) %> ejendomme</span></div>
      <%- include('partials/section-nav', { sectionNav: viewNav }) %>
      <% if (error) { %><div class="form-alert"><span>!</span><div><strong>Tilsynsarket kunne ikke læses</strong><p><%= error %></p></div></div><% } %>

      <% if (isDashboard && !error) { const a = analytics; const next = a.planned[0]; %>
        <div class="workspace-summary propbinder-summary">
          <article class="stat-card"><div class="stat-top"><span>Ejendomme i tilsyn</span><span class="stat-icon blue">⌂</span></div><div class="stat-value"><%= number(a.totals.inspections) %></div><div class="stat-foot"><%= number(a.totals.linked) %> koblet til Cibus-ejendomsnr. · median <%= a.totals.medianDays == null ? '—' : number(a.totals.medianDays) + ' dage' %> siden tilsyn</div><div class="stat-line blue-line"></div></article>
          <article class="stat-card"><a class="stat-card-link" href="<%= filterHref({ alder: 'under3' }) %>"><div class="stat-top"><span>Tilset seneste 3 mdr.</span><span class="stat-icon green">✓</span></div><div class="stat-value"><%= number(a.totals.recent) %></div><div class="stat-foot"><%= a.totals.inspections ? Math.round(a.totals.recent / a.totals.inspections * 100) : 0 %>% af ejendommene</div><div class="stat-line green-line"></div></a></article>
          <article class="stat-card"><a class="stat-card-link" href="<%= filterHref({ alder: 'over12' }) %>"><div class="stat-top"><span>Over 12 mdr. siden</span><span class="stat-icon sand">!</span></div><div class="stat-value tilsyn-warn-value"><%= number(a.totals.over12) %></div><div class="stat-foot">Seneste tilsyn for over et år siden</div><div class="stat-line sand-line"></div></a></article>
          <article class="stat-card"><div class="stat-top"><span>Planlagte tilsyn</span><span class="stat-icon blue">◷</span></div><div class="stat-value"><%= number(a.totals.planned) %></div><div class="stat-foot"><%= next ? 'Næste: ' + date(next.planned, { day: 'numeric', month: 'short' }) + ' · ' + next.name : 'Ingen planlagt i bemærkningerne' %></div><div class="stat-line blue-line"></div></article>
        </div>
        <div class="pb-dashboard-grid">
          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">STATUS</p><h2>Tid siden seneste tilsyn</h2></div></div>
            <% const bucketTotal = a.buckets.reduce((sum, item) => sum + item.count, 0); let offset = 25; %>
            <div class="pb-donut-layout">
              <svg class="pb-donut" viewBox="0 0 42 42" role="img" aria-label="Tid siden seneste tilsyn"><title>Tid siden seneste tilsyn</title><circle class="pb-donut-track" cx="21" cy="21" r="15.915"></circle><% a.buckets.filter(item => item.count).forEach((item) => { const share = item.count / bucketTotal * 100; %><a href="<%= filterHref({ alder: item.key }) %>"><circle class="pb-donut-slice <%= bucketClass[item.key] %>" cx="21" cy="21" r="15.915" stroke-dasharray="<%= share.toFixed(3) %> <%= (100 - share).toFixed(3) %>" stroke-dashoffset="<%= offset.toFixed(3) %>"><title><%= item.label %>: <%= number(item.count) %></title></circle></a><% offset -= share; }) %><text class="pb-donut-value" x="21" y="21.5"><%= number(bucketTotal) %></text><text class="pb-donut-label" x="21" y="26">EJENDOMME</text></svg>
              <ul class="pb-legend fox-legend"><% a.buckets.forEach((item) => { %><li><a href="<%= filterHref({ alder: item.key }) %>"><span class="pb-swatch <%= bucketClass[item.key] %>"></span><span class="pb-legend-label"><%= item.label %></span><strong><%= number(item.count) %></strong><span class="pb-legend-share"><%= bucketTotal ? Math.round(item.count / bucketTotal * 100) : 0 %>%</span></a></li><% }) %></ul>
            </div>
          </section>

          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">AKTIVITET</p><h2>Seneste tilsyn pr. måned</h2></div><span class="count-badge">12 mdr.</span></div>
            <% const monthMax = Math.max(1, ...a.months.map(m => m.count)); const colWidth = 600 / a.months.length; %>
            <svg class="pb-columns" viewBox="0 0 600 230" role="img" aria-label="Seneste tilsyn pr. måned"><title>Seneste tilsyn pr. måned</title>
              <line class="pb-axis" x1="0" y1="190" x2="600" y2="190"></line>
              <% a.months.forEach((month, index) => { const height = Math.round(month.count / monthMax * 160); const x = index * colWidth + colWidth * 0.2; const center = (x + colWidth * 0.3).toFixed(1); %>
                <rect class="pb-column" x="<%= x.toFixed(1) %>" y="<%= 190 - height %>" width="<%= (colWidth * 0.6).toFixed(1) %>" height="<%= height %>" rx="3"><title><%= month.label %> <%= month.year %>: <%= number(month.count) %> ejendomme med seneste tilsyn</title></rect>
                <% if (month.count) { %><text class="pb-column-value" x="<%= center %>" y="<%= 184 - height %>"><%= number(month.count) %></text><% } %>
                <text class="pb-column-label" x="<%= center %>" y="208"><%= month.label %></text>
                <% if (index === 0 || month.label.startsWith('jan')) { %><text class="pb-column-year" x="<%= center %>" y="224"><%= month.year %></text><% } %>
              <% }) %>
            </svg>
          </section>

          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">OPFØLGNING</p><h2>Længst tid siden tilsyn</h2></div><span class="count-badge">Top <%= a.oldest.length %></span></div>
            <% const oldestMax = Math.max(0, ...a.oldest.map(item => item.daysSince)); %>
            <ol class="pb-bars"><% a.oldest.forEach(item => { %><li><a href="<%= filterHref({ q: item.name }) %>" title="Vis <%= item.name %> i listen"><span class="pb-bar-label"><%= item.name %><small><%= item.propertyNumber || 'Ikke koblet' %> · seneste <%= date(item.latest) %><%= item.planned ? ' · planlagt ' + date(item.planned, { day: 'numeric', month: 'short' }) : '' %></small></span><svg class="pb-bar-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect class="pb-bar-fill <%= bucketClass[item.bucket] %>" width="<%= percent(item.daysSince, oldestMax) %>" height="10"></rect></svg><strong><%= number(item.daysSince) %> d.</strong></a></li><% }) %></ol>
          </section>

          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">PLANLÆGNING</p><h2>Planlagte tilsyn</h2></div><span class="count-badge"><%= number(a.planned.length) %></span></div>
            <% if (!a.planned.length) { %><p class="tilsyn-empty-note">Ingen bemærkninger med "Planlagt til" i arket.</p><% } else { %>
            <ul class="tilsyn-agenda"><% a.planned.forEach(item => { %><li><span class="tilsyn-agenda-date"><strong><%= new Date(item.planned).getUTCDate() %></strong><%= date(item.planned, { month: 'short' }).replace('.', '') %></span><span class="tilsyn-agenda-text"><strong><%= item.name %></strong><small><%= item.propertyNumber || '' %><%= item.propertyNumber ? ' · ' : '' %>Seneste tilsyn <%= date(item.latest) %> (<%= ago(item.daysSince) %>)</small></span></li><% }) %></ul>
            <% } %>
          </section>

          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">GEOGRAFI</p><h2>Ejendomme pr. region</h2></div><span class="count-badge"><%= a.regions.length %> regioner</span></div>
            <% const regionMax = Math.max(0, ...a.regions.map(item => item.count)); %>
            <ol class="pb-bars"><% a.regions.forEach(item => { const rows = inspections.filter(i => i.region === item.label); const recent = rows.filter(i => i.daysSince != null && i.daysSince <= 183).length; %><li><a href="<%= filterHref({ region: item.label }) %>" title="Vis tilsyn i <%= item.label %>"><span class="pb-bar-label"><%= item.label %><small><%= number(recent) %> tilset inden for 6 mdr.</small></span><svg class="pb-bar-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect class="pb-bar-fill pb-c0" width="<%= percent(item.count, regionMax) %>" height="10"></rect></svg><strong><%= number(item.count) %></strong></a></li><% }) %></ol>
          </section>

          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">DÆKNING</p><h2>Bemærkninger og dækning</h2></div></div>
            <% const remarkMax = Math.max(0, ...a.remarkTypes.map(item => item.count)); %>
            <ol class="pb-bars"><% a.remarkTypes.forEach(item => { %><li><a href="<%= filterHref({ bemaerkning: item.label }) %>"><span class="pb-bar-label"><%= item.label %></span><svg class="pb-bar-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect class="pb-bar-fill pb-c4" width="<%= percent(item.count, remarkMax) %>" height="10"></rect></svg><strong><%= number(item.count) %></strong></a></li><% }) %></ol>
            <div class="tilsyn-coverage <%= withoutInspection.length ? 'warn' : 'ok' %>"><span><%= withoutInspection.length ? '!' : '✓' %></span><div><strong><%= withoutInspection.length ? number(withoutInspection.length) + ' Cibus-ejendom' + (withoutInspection.length === 1 ? '' : 'me') + ' uden registreret tilsyn' : 'Alle Cibus-ejendomme har et registreret tilsyn' %></strong><% if (withoutInspection.length) { %><p><%= withoutInspection.map(p => p.name + ' (' + p.number + ')').join(', ') %> står i ejendomsoversigten, men ikke i tilsynsarket.</p><% } %></div></div>
          </section>
        </div>
      <% } else if (!error) { %>
        <section class="panel records-panel" data-filter-scope>
          <div class="panel-heading"><div><p class="eyebrow">TILSYNSLISTE</p><h2>Tilsyn pr. ejendom <span class="count-badge" data-filter-count><%= number(inspections.length) %></span></h2></div><span class="read-only-label">Kun læsning · sorteret efter længst siden tilsyn</span></div>
          <div class="propbinder-toolbar fox-toolbar">
            <label class="search-wrap"><span>⌕</span><input type="search" data-filter-search value="<%= listFilters.q %>" placeholder="Søg i ejendom, postnr., bemærkning…" aria-label="Søg i tilsyn"></label>
            <div class="propbinder-filters">
              <select class="filter-select" data-filter-key="alder" aria-label="Tid siden tilsyn"><option value="">Alle aldre</option><% buckets.forEach(bucket => { %><option value="<%= bucket.key %>" <%= listFilters.alder === bucket.key ? 'selected' : '' %>><%= bucket.label %></option><% }) %></select>
              <select class="filter-select" data-filter-key="region" aria-label="Region"><option value="">Alle regioner</option><% options('region').forEach(value => { %><option <%= listFilters.region === value ? 'selected' : '' %>><%= value %></option><% }) %></select>
              <select class="filter-select" data-filter-key="type" aria-label="Type"><option value="">Alle typer</option><% options('ownerType').forEach(value => { %><option <%= listFilters.type === value ? 'selected' : '' %>><%= value %></option><% }) %></select>
              <select class="filter-select" data-filter-key="bemaerkning" aria-label="Bemærkning"><option value="">Alle bemærkninger</option><% options('remarkType').forEach(value => { %><option <%= listFilters.bemaerkning === value ? 'selected' : '' %>><%= value %></option><% }) %></select>
              <button type="button" class="filter-reset" data-filter-reset>Nulstil</button>
            </div>
          </div>
          <div class="table-wrap"><table class="records-table propbinder-table fox-table tilsyn-table">
            <colgroup><col class="tilsyn-col-property"><col class="tilsyn-col-zip"><col class="tilsyn-col-date"><col class="tilsyn-col-date"><col class="tilsyn-col-status"><col class="tilsyn-col-remark"></colgroup>
            <thead><tr><th>EJENDOM</th><th>POSTNR.</th><th>SENESTE TILSYN</th><th>FORRIGE TILSYN</th><th>STATUS</th><th>BEMÆRKNING</th></tr></thead>
            <tbody><% inspections.forEach(item => { %><tr data-filter-row data-f-alder="<%= item.bucket %>" data-f-region="<%= item.region %>" data-f-type="<%= item.ownerType %>" data-f-bemaerkning="<%= item.remarkType %>">
              <td><strong class="task-property"><%= item.name %></strong><span class="task-property-meta"><%= item.propertyNumber ? item.propertyNumber + (item.propertyName && item.propertyName !== item.name ? ' · ' + item.propertyName : '') : 'Ikke koblet til ejendomsnr.' %><%= item.ownerType !== 'Ejendom' ? ' · ' + item.ownerType : '' %></span></td>
              <td><span class="fox-cell-main"><%= item.zip || '—' %></span><span class="task-property-meta"><%= item.region %></span></td>
              <td><span class="fox-cell-main"><%= date(item.latest) %></span><span class="task-property-meta"><%= ago(item.daysSince) %></span></td>
              <td><span class="fox-cell-main"><%= item.hasPrevious ? date(item.previous) : '—' %></span><span class="task-property-meta"><%= item.intervalDays != null ? number(item.intervalDays) + ' dage mellem tilsyn' : 'Kun ét tilsyn registreret' %></span></td>
              <td><span class="record-status fox-pill tilsyn-pill-<%= item.bucket %>"><%= item.bucketLabel %></span></td>
              <td><span class="fox-cell-main"><%= item.remark || '—' %></span><% if (item.planned) { %><span class="task-property-meta">Planlagt <%= date(item.planned, { weekday: 'short', day: 'numeric', month: 'short' }) %></span><% } %></td>
            </tr><% }) %></tbody>
          </table></div>
          <div class="empty-state compact" data-filter-empty hidden><strong>Ingen tilsyn matcher filtrene</strong></div>
        </section>
      <% } %>
      <footer class="page-footer"><span>© <%= new Date().getFullYear() %> <%= settings.company_name %></span><span>Brand tilsyn · status beregnet pr. <%= new Date().toLocaleDateString('da-DK', { day: 'numeric', month: 'long', year: 'numeric' }) %></span></footer>
    </section>
  </main>
</body></html>

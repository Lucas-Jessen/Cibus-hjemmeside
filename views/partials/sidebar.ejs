<aside class="sidebar">
  <a class="brand co-brand-lockup" href="/workspaces/properties" aria-label="Cibus x Forenede"><img class="brand-logo co-brand-focus" src="/cibus-logo-white.svg" alt="Cibus Real Estate"><span class="co-brand-x" aria-hidden="true">×</span><span class="co-brand-forenede"><span class="co-brand-globe" aria-hidden="true"></span><span class="co-brand-wordmark">Forenede<small>Service</small></span></span></a>
  <nav class="main-nav" aria-label="Hovedmenu">
    <div class="workspace-label">ARBEJDSOMRÅDER</div>
    <a class="nav-link <%= currentPath === '/rapporter' ? 'active' : '' %>" href="/rapporter"><span class="nav-icon">▤</span> BR18-kontroller</a>
    <a class="nav-link <%= currentPath === '/workspaces/properties' ? 'active' : '' %>" href="/workspaces/properties"><span class="nav-icon">⌂</span> Ejendomme</a>
    <a class="nav-link <%= currentPath === '/kontrakter' ? 'active' : '' %>" href="/kontrakter"><span class="nav-icon">▧</span> Kontrakter</a>
    <% if (user.role === 'admin') { %><a class="nav-link <%= currentPath === '/propbinder-tasks' ? 'active' : '' %>" href="/propbinder-tasks"><span class="nav-icon">◇</span> Opgaver</a><% } %>
    <a class="nav-link <%= currentPath === '/tilsyn' ? 'active' : '' %>" href="/tilsyn"><span class="nav-icon">◉</span> Tilsyn af ejendomme</a>
    <div class="workspace-label admin-label"><%= user.role === 'admin' ? 'ADMINISTRATION' : 'MIN PROFIL' %></div>
    <a class="nav-link <%= currentPath === '/settings' || currentPath === '/users' ? 'active' : '' %>" href="/settings"><span class="nav-icon">⚙</span> Indstillinger</a>
  </nav>
  <div class="sidebar-bottom">
    <div class="sidebar-note"><span class="note-spark">C</span><p>Nordisk dagligvareejendom.<br><strong>Fælles retning.</strong></p></div>
    <div class="sidebar-user">
      <div class="avatar"><%= user.name.split(' ').map(part => part[0]).slice(0, 2).join('').toUpperCase() %></div>
      <div class="sidebar-user-info"><strong><%= user.name %></strong><span><%= { admin: 'Admin', normal: 'Normal', view: 'View' }[user.role] || 'Normal' %></span></div>
      <form action="/logout" method="post"><button class="icon-button logout-button" type="submit" aria-label="Log ud" title="Log ud"><svg class="logout-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M13 8V4a1 1 0 0 0-1-1H4.5a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1H12a1 1 0 0 0 1-1v-4"/><path d="M3.5 3.4l6.5 2.4v16.5l-6.5-1.9z" fill="currentColor" fill-opacity=".14"/><circle cx="8" cy="13.4" r=".55" fill="currentColor" stroke="none"/><path d="M15.5 12H22"/><path d="M19 9l3 3-3 3"/></svg></button></form>
    </div>
  </div>
</aside>

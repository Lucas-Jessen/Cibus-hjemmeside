<%- include('partials/head', { title: 'Log ind' }) %>
<body class="login-page">
  <main class="login-layout">
    <section class="login-story"><a class="brand brand-light co-brand-lockup" href="/login" aria-label="Cibus x Forenede"><img class="brand-logo co-brand-focus" src="/cibus-logo-white.svg" alt="Cibus Real Estate"><span class="co-brand-x" aria-hidden="true">×</span><span class="co-brand-forenede"><span class="co-brand-globe" aria-hidden="true"></span><span class="co-brand-wordmark">Forenede<small>Service</small></span></span></a><div class="story-content"><span class="story-kicker"><i></i> NORDIC GROCERY REAL ESTATE</span><h1>Ejendomme<br>i hverdagens<br><em>centrum.</em></h1><p>Fælles arbejdsområde for Cibus Real Estate og Forenede Service: ejendomme og driftsopgaver samlet ét sted.</p></div><div class="story-footer"><span>CIBUS × FORENEDE</span><span>DENMARK · FINLAND · NORWAY · SWEDEN</span></div><div class="story-shape shape-large"></div><div class="story-shape shape-small"></div></section>
    <section class="login-main"><div class="login-main-inner"><div class="mobile-brand co-brand-lockup co-brand-lockup--light"><img class="brand-logo co-brand-focus" src="/cibus-logo-green.svg" alt="Cibus Real Estate"><span class="co-brand-x" aria-hidden="true">×</span><span class="co-brand-forenede"><span class="co-brand-globe" aria-hidden="true"></span><span class="co-brand-wordmark">Forenede<small>Service</small></span></span></div><div class="login-heading"><span class="welcome-label">VELKOMMEN TILBAGE</span><h2>Godt at se dig.</h2><p>Log ind på dit arbejdsområde.</p></div>
      <form class="login-form" action="/login" method="post"><% if (error) { %><div class="form-alert" role="alert"><span>!</span><%= error %></div><% } %><label for="email">E-mailadresse</label><div class="input-wrap"><span class="field-icon">✉</span><input id="email" name="email" type="email" autocomplete="username" placeholder="dig@forenede.dk" required autofocus></div><div class="password-label"><label for="password">Adgangskode</label><span class="secure-dot"></span></div><div class="input-wrap"><span class="field-icon">⌑</span><input id="password" name="password" type="password" autocomplete="current-password" placeholder="Indtast din adgangskode" required><button type="button" class="password-toggle" aria-label="Vis adgangskode">Vis</button></div><button class="button button-primary login-submit" type="submit">Log ind <span>→</span></button><p class="login-help">Brug for hjælp? <a href="mailto:kontakt@forenede.dk">Kontakt os</a></p></form><div class="login-bottom"><span>© <%= new Date().getFullYear() %> Cibus Real Estate × Forenede Service</span><span>Skabt med omtanke <b>✳</b></span></div></div></section>
  </main>
</body></html>

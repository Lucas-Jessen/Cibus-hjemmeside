<%- include('partials/head', { title: 'Propbinder-opgaver' }) %>
<%
  const isLive = service.mode === 'live';
  const isDashboard = sectionNav.activeKey === 'dashboard';
  const statuses = [...new Set(tasks.map(task => task.status))].sort((a, b) => a.localeCompare(b, 'da'));
  const unmappedStatusIds = Object.entries(tasks.filter(task => task.status === 'Ukendt' && task.statusId).reduce((counts, task) => { counts[task.statusId] = (counts[task.statusId] || 0) + 1; return counts; }, {})).sort((a, b) => b[1] - a[1]);
  const showProperty = tasks.some(task => task.property);
  const showPriority = tasks.some(task => task.priority);
  const propertyOptions = [...new Map(tasks.filter(task => task.property).map(task => [task.property, task.propertyNumber])).entries()].sort((a, b) => a[0].localeCompare(b[0], 'da'));
  const filter = service.filter;
  const warnings = service.warnings || [];
  const number = (value) => new Intl.NumberFormat('da-DK').format(value);
  const formatDate = (value) => value ? new Date(value).toLocaleDateString('da-DK', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
  const shorten = (text) => text.length > 180 ? text.slice(0, 177).trimEnd() + '…' : text;
  const listHref = (params) => '/propbinder-tasks?section=opgaveliste&' + Object.entries(params).map(([key, value]) => key + '=' + encodeURIComponent(value)).join('&');
  const percent = (count, max) => max ? Math.max(2, Math.round(count / max * 100)) : 0;
  const viaLabel = { tidsregistrering: 'Tidsregistrering', ejendomsfelt: 'Ejendom i Propbinder', 'lejemålsnr.': 'Lejemålsnr. i tekst', 'ejendomsnr. i tekst': 'Ejendomsnr. i tekst', 'adresse/navn i tekst': 'Adresse/navn i tekst', sag: 'Sag i Propbinder', henvendelse: 'Via tilhørende sag' };
  const viaOf = (task) => viaLabel[task.link && task.link.via] || 'Ukendt';
  const viaCounts = Object.entries(tasks.reduce((counts, task) => { const key = viaOf(task); counts[key] = (counts[key] || 0) + 1; return counts; }, {})).sort((a, b) => b[1] - a[1]);
  const isText = (task) => task.link && /tekst/.test(task.link.via);
  const kindCounts = { Opgave: tasks.filter(task => task.kind !== 'Sag').length, Sag: tasks.filter(task => task.kind === 'Sag').length };
  // Month a task was created (local time, same as the dashboard's "Oprettede opgaver pr. måned").
  const monthOf = (task) => { if (!task.createdAt) return ''; const d = new Date(task.createdAt); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0'); };
  const monthName = (key) => new Date(Number(key.slice(0, 4)), Number(key.slice(5)) - 1, 1).toLocaleDateString('da-DK', { month: 'long', year: 'numeric' });
  const monthOptions = [...new Set(tasks.map(monthOf).filter(Boolean))].sort().reverse();
  const dayOf = (task) => monthOf(task) ? monthOf(task) + '-' + String(new Date(task.createdAt).getDate()).padStart(2, '0') : '';
  const dayName = (key) => new Date(Number(key.slice(0, 4)), Number(key.slice(5, 7)) - 1, Number(key.slice(8, 10))).toLocaleDateString('da-DK', { day: 'numeric', month: 'long', year: 'numeric' });
%>
<body class="app-shell">
  <%- include('partials/sidebar', { user, settings, currentPath }) %>
  <main class="main-content">
    <header class="topbar"><div class="breadcrumb">Cibus <span>/</span> <a href="/propbinder-tasks">Propbinder-opgaver</a> <span>/</span> <strong><%= sectionNav.activeSection %></strong></div><div class="topbar-date"><span class="status-dot"></span> <%= isLive && service.fetchedAt ? 'Hentet ' + new Date(service.fetchedAt).toLocaleTimeString('da-DK', { hour: '2-digit', minute: '2-digit' }) : 'Read-only integration' %></div></header>
    <section class="page-content">
      <div class="page-heading-row"><div><p class="eyebrow">PROPBINDER · <%= isLive ? 'LIVE DATA' : 'TESTDATA' %></p><h1>Opgaver</h1><p class="page-subtitle"><%= isLive ? 'Opgaver og sager hentet direkte fra Propbinder Partner API. Listen opdateres automatisk i baggrunden og kan ikke ændres her.' : 'En opsætning af opgaver tilknyttede til kunden. Data er læsbare og kan ikke ændres.' %></p></div><span class="mode-badge <%= service.mode %>"><span></span><%= isLive ? 'Live data' : 'Testdata' %></span></div>
      <%- include('partials/section-nav', { sectionNav }) %>
      <% if (error) { %><div class="form-alert"><span>!</span><div><strong>Kunne ikke hente opgaver fra Propbinder</strong><p><%= error %></p></div></div><% } %>
      <% if (filter) { %><div class="propbinder-filter-note"><strong>Viser <%= number(tasks.length) %> opgaver</strong> (<%= number(filter.shown) %> af <%= number(filter.total) %> opgaver og <%= number(filter.cases || 0) %> af <%= number(filter.casesTotal || 0) %> sager i Propbinder) — <% if (filter.createdFrom) { %>oprettet fra og med <%= new Date(filter.createdFrom + 'T00:00:00').toLocaleDateString('da-DK', { day: 'numeric', month: 'long', year: 'numeric' }) %> (<%= number(filter.beforeStart) %> ældre er udeladt), <% } %>kun på de <%= filter.propertyCount %> Cibus-ejendomme fra SharePoint-listen (ændret <%= new Date(filter.listModifiedAt).toLocaleString('da-DK', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>). Sager har ejendommen med fra Propbinder<% if (filter.casesWithTask) { %>; <%= number(filter.casesWithTask) %> af dem har en opgave, der blev oprettet sammen med sagen (sag og opgave vises hver for sig med egen status)<% } %>. Opgaver har ikke ejendom: <% if (filter.linkedByCase) { %><%= number(filter.linkedByCase) %> er koblet via deres sag, <% } %><%= number(filter.linkedByData || 0) %> er koblet via tidsregistrering<% if (filter.textMatching) { %> og <%= number(filter.linkedByText || 0) %> via adresse, navn eller lejemålsnr. i opgavens tekst<% } %>.<% if (filter.unlinked || filter.otherProperties) { %> Udeladt: <%= number(filter.otherProperties) %> på andre ejendomme, <%= number(filter.unlinked) %> uden kendt ejendom.<% } %></div><% } else if (isLive && !service.propertyFilterConfigured) { %><div class="propbinder-filter-note"><strong>Ingen ejendomsfilter.</strong> Angiv <code>PROPERTY_LIST_PATH</code> i <code>.env</code> for kun at vise opgaver på ejendommene i Ejendomslisten.</div><% } %>
      <% warnings.forEach(warning => { %><div class="form-alert propbinder-status-hint"><span>!</span><div><strong>Bemærk</strong><p><%= warning %></p></div></div><% }) %>
      <% if (unmappedStatusIds.length) { %><details class="propbinder-status-hint propbinder-details"><summary><strong>Statusnavne mangler</strong> — <%= unmappedStatusIds.length %> status-id'er uden navn</summary><p>Propbinder sender status som id'er. Tilføj navne i <code>.env</code> som <code>PROPBINDER_TASK_STATUSES=id=Åben;id=Afsluttet</code>. Fundne id'er: <% unmappedStatusIds.forEach(([id, count], index) => { %><code><%= id %></code> (<%= number(count) %>)<%= index < unmappedStatusIds.length - 1 ? ', ' : '' %><% }) %>.</p></details><% } %>

      <% if (isDashboard) { const a = analytics; %>
        <div class="workspace-summary propbinder-summary">
          <article class="stat-card"><div class="stat-top"><span>Opgaver</span><span class="stat-icon blue">☷</span></div><div class="stat-value"><%= number(a.totals.tasks) %></div><div class="stat-foot"><%= number(kindCounts.Opgave) %> opgaver og <%= number(kindCounts.Sag) %> sager på <%= a.totals.properties %> ejendomme</div><div class="stat-line blue-line"></div></article>
          <article class="stat-card"><div class="stat-top"><span>Gentagne opgaver</span><span class="stat-icon green">↻</span></div><div class="stat-value"><%= number(a.totals.recurringGroups) %></div><div class="stat-foot">Titler brugt flere gange (<%= number(a.totals.recurringTasks) %> opgaver)</div><div class="stat-line green-line"></div></article>
          <article class="stat-card"><div class="stat-top"><span>Frist inden 30 dage</span><span class="stat-icon sand">◷</span></div><div class="stat-value"><%= number(a.totals.dueSoon) %></div><div class="stat-foot"><%= unmappedStatusIds.length ? 'Ukendt status tælles som åben' : 'Ikke afsluttede' %></div><div class="stat-line sand-line"></div></article>
          <article class="stat-card"><div class="stat-top"><span>Frist overskredet</span><span class="stat-icon sand">!</span></div><div class="stat-value"><%= number(a.totals.overdue) %></div><div class="stat-foot"><%= unmappedStatusIds.length ? 'Frist før i dag; ukendt status tælles som åben' : 'Frist før i dag, ikke afsluttet' %></div><div class="stat-line sand-line"></div></article>
        </div>
        <% if (!a.totals.tasks) { %><div class="empty-state workspace-empty panel"><span class="empty-icon">☷</span><strong>Ingen opgaver at vise grafer for</strong></div><% } else { %>
        <div class="pb-dashboard-grid">
          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">STATUS</p><h2>Fordeling af opgavestatus</h2></div></div>
            <% const statusTotal = a.statuses.reduce((sum, item) => sum + item.count, 0); let offset = 25; %>
            <div class="pb-donut-layout">
              <svg class="pb-donut" viewBox="0 0 42 42" role="img" aria-label="Fordeling af opgavestatus"><title>Fordeling af opgavestatus</title><circle class="pb-donut-track" cx="21" cy="21" r="15.915"></circle><% a.statuses.forEach((item, index) => { const share = item.count / statusTotal * 100; %><a href="<%= listHref({ status: item.label }) %>"><circle class="pb-donut-slice pb-c<%= index % 8 %>" cx="21" cy="21" r="15.915" stroke-dasharray="<%= share.toFixed(3) %> <%= (100 - share).toFixed(3) %>" stroke-dashoffset="<%= offset.toFixed(3) %>"><title><%= item.label %>: <%= number(item.count) %> – klik for at se dem i listen</title></circle></a><% offset -= share; }) %><text class="pb-donut-value" x="21" y="21.5"><%= number(statusTotal) %></text><text class="pb-donut-label" x="21" y="26">OPGAVER</text></svg>
              <ul class="pb-legend fox-legend"><% a.statuses.forEach((item, index) => { %><li><a href="<%= listHref({ status: item.label }) %>" title="Vis opgaver og sager med status <%= item.label %>"><span class="pb-swatch pb-c<%= index % 8 %>"></span><span class="pb-legend-label"><%= item.label %></span><strong><%= number(item.count) %></strong><span class="pb-legend-share"><%= Math.round(item.count / statusTotal * 100) %>%</span></a></li><% }) %></ul>
            </div>
          </section>

          <section class="panel pb-chart-panel pb-development-panel">
            <% const c = creationChart; const monthLabel = (key) => new Date(Number(key.slice(0, 4)), Number(key.slice(5, 7)) - 1, 1).toLocaleDateString('da-DK', { month: 'long', year: 'numeric' }); const monthsDesc = [...c.months].reverse(); const shortMonth = (key) => new Date(Number(key.slice(0, 4)), Number(key.slice(5, 7)) - 1, 1).toLocaleDateString('da-DK', { month: 'short', year: 'numeric' }); %>
            <div class="panel-heading"><div><p class="eyebrow">UDVIKLING</p><h2>Oprettede opgaver <%= c.mode === 'month' ? 'pr. dag' : 'pr. måned' %></h2><p class="pb-chart-subtitle"><%= c.title %> · <%= number(c.total) %> oprettet<%= c.truncated ? ' (viser de seneste 36 måneder)' : '' %></p></div><% if (c.mode !== 'month' || c.month !== c.current) { %><a class="count-badge pb-chart-reset" href="/propbinder-tasks?section=dashboard" title="Tilbage til indeværende måned">Nulstil til nu</a><% } %></div>
            <% const periodValue = c.mode === 'year' ? 'aar:' + c.year : c.mode === 'month' ? 'maaned:' + c.month : ''; %>
            <div class="pb-chart-filters">
              <form method="get" action="/propbinder-tasks" class="pb-chart-filter pb-chart-filter-period">
                <input type="hidden" name="section" value="dashboard">
                <label><span>Periode</span><select name="udv_periode" data-auto-submit aria-label="Vis et år eller en måned">
                  <% if (c.mode === 'interval') { %><option value="" selected disabled>Eget interval</option><% } %>
                  <optgroup label="År (pr. måned)">
                    <option value="aar:seneste" <%= periodValue === 'aar:seneste' ? 'selected' : '' %>>Seneste 12 mdr.</option>
                    <% c.years.forEach(y => { %><option value="aar:<%= y %>" <%= periodValue === 'aar:' + y ? 'selected' : '' %>>Hele <%= y %></option><% }) %>
                  </optgroup>
                  <optgroup label="Måned (pr. dag)">
                    <% monthsDesc.forEach(key => { %><option value="maaned:<%= key %>" <%= periodValue === 'maaned:' + key ? 'selected' : '' %>><%= shortMonth(key) %><%= key === c.current ? ' •' : '' %></option><% }) %>
                  </optgroup>
                </select></label>
                <noscript><button type="submit" class="filter-reset">Vis</button></noscript>
              </form>
              <form method="get" action="/propbinder-tasks" class="pb-chart-filter pb-chart-filter-interval">
                <input type="hidden" name="section" value="dashboard">
                <label><span>Fra</span><select name="udv_fra" aria-label="Interval fra måned"><% c.months.forEach(key => { %><option value="<%= key %>" <%= (c.mode !== 'month' ? c.from : c.months[Math.max(0, c.months.length - 12)]) === key ? 'selected' : '' %>><%= shortMonth(key) %></option><% }) %></select></label>
                <label><span>Til</span><select name="udv_til" aria-label="Interval til måned"><% monthsDesc.forEach(key => { %><option value="<%= key %>" <%= (c.mode !== 'month' ? c.to : c.current) === key ? 'selected' : '' %>><%= shortMonth(key) %></option><% }) %></select></label>
                <button type="submit" class="filter-reset">Vis</button>
              </form>
            </div>
            <% const chartMax = Math.max(1, ...c.columns.map(col => col.count)); const colWidth = 600 / c.columns.length; const dense = c.columns.length > 20; %>
            <svg class="pb-columns<%= dense ? ' pb-columns-dense' : '' %>" viewBox="0 0 600 230" role="img" aria-label="Oprettede opgaver – <%= c.title %>"><title>Oprettede opgaver – <%= c.title %></title>
              <line class="pb-axis" x1="0" y1="190" x2="600" y2="190"></line>
              <% c.columns.forEach((col) => { const height = col.count ? Math.max(3, Math.round(col.count / chartMax * 160)) : 0; const x = c.columns.indexOf(col) * colWidth + colWidth * 0.18; const center = (x + colWidth * 0.32).toFixed(1); %>
                <% if (col.count) { %><a href="<%= listHref(col.filter) %>"><rect class="pb-column" x="<%= x.toFixed(1) %>" y="<%= 190 - height %>" width="<%= (colWidth * 0.64).toFixed(1) %>" height="<%= height %>" rx="2"><title><%= col.title %>: <%= number(col.count) %> – klik for at se dem i listen</title></rect></a>
                <text class="pb-column-value" x="<%= center %>" y="<%= 184 - height %>"><%= number(col.count) %></text><% } %>
                <text class="pb-column-label<%= col.future ? ' pb-column-future' : '' %>" x="<%= center %>" y="208"><%= col.label %></text>
                <% if (col.sub) { %><text class="pb-column-year" x="<%= center %>" y="224"><%= col.sub %></text><% } %>
              <% }) %>
            </svg>
            <% if (!c.total) { %><p class="pb-panel-note">Ingen opgaver eller sager oprettet i <%= c.mode === 'interval' ? 'intervallet' : monthLabel(c.month) %>.</p><% } %>
          </section>

          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">EJENDOMME</p><h2>Flest opgaver pr. ejendom</h2></div><span class="count-badge">Top <%= a.byProperty.length %></span></div>
            <% const propertyMax = a.byProperty.length ? a.byProperty[0].count : 0; %>
            <ol class="pb-bars"><% a.byProperty.forEach(item => { %><li><a href="<%= listHref({ property: item.property }) %>" title="Vis opgaver på <%= item.property %>"><span class="pb-bar-label"><%= item.property %><small><%= item.propertyNumber || '' %></small></span><svg class="pb-bar-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect class="pb-bar-fill pb-c0" width="<%= percent(item.count, propertyMax) %>" height="10"></rect></svg><strong><%= number(item.count) %></strong></a></li><% }) %></ol>
          </section>

          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">GENTAGNE OPGAVER</p><h2>Hyppigste opgavetitler</h2></div><span class="count-badge">Top <%= a.recurringTitles.length %></span></div>
            <% const titleMax = a.recurringTitles.length ? a.recurringTitles[0].count : 0; %>
            <% if (a.recurringTitles.length) { %><ol class="pb-bars"><% a.recurringTitles.forEach(item => { %><li><a href="<%= listHref({ q: item.title }) %>" title="Vis opgaver med denne titel"><span class="pb-bar-label"><%= item.title %><small>på <%= item.propertyCount %> <%= item.propertyCount === 1 ? 'ejendom' : 'ejendomme' %></small></span><svg class="pb-bar-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect class="pb-bar-fill pb-c1" width="<%= percent(item.count, titleMax) %>" height="10"></rect></svg><strong><%= number(item.count) %></strong></a></li><% }) %></ol><% } else { %><div class="empty-state compact"><strong>Ingen gentagne opgavetitler</strong></div><% } %>
          </section>

          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">ANSVARLIGE</p><h2>Opgaver pr. ansvarlig</h2></div><span class="count-badge">Top <%= a.byResponsible.length %></span></div>
            <% const responsibleMax = a.byResponsible.length ? a.byResponsible[0].count : 0; %>
            <ol class="pb-bars"><% a.byResponsible.forEach(item => { %><li><a href="<%= listHref({ q: item.name }) %>" title="Vis opgaver for <%= item.name %>"><span class="pb-bar-label"><%= item.name %></span><svg class="pb-bar-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect class="pb-bar-fill pb-c2" width="<%= percent(item.count, responsibleMax) %>" height="10"></rect></svg><strong><%= number(item.count) %></strong></a></li><% }) %></ol>
          </section>

          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">KOBLING</p><h2>Sådan er opgaverne koblet til ejendom</h2></div></div>
            <% const viaMax = viaCounts.length ? viaCounts[0][1] : 0; %>
            <ol class="pb-bars"><% viaCounts.forEach(([label, count]) => { %><li><a href="<%= listHref({ via: label }) %>"><span class="pb-bar-label"><%= label %></span><svg class="pb-bar-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect class="pb-bar-fill <%= /tekst/i.test(label) ? 'pb-c2' : 'pb-c0' %>" width="<%= percent(count, viaMax) %>" height="10"></rect></svg><strong><%= number(count) %></strong></a></li><% }) %></ol>
            <p class="pb-panel-note">Propbinders opgaveliste har intet ejendomsfelt. Opgaver koblet via tekst bygger på, at adressen, navnet eller lejemålsnummeret står i opgaven – kontrollér dem i listen.</p>
          </section>

          <section class="panel pb-chart-panel">
            <div class="panel-heading"><div><p class="eyebrow">TYPE</p><h2>Opgaver og sager</h2></div></div>
            <% const kindMax = Math.max(kindCounts.Opgave, kindCounts.Sag); %>
            <ol class="pb-bars"><% [['Opgave', 'Opgaver', 'pb-c0'], ['Sag', 'Sager (henvendelser)', 'pb-c5']].forEach(([key, label, color]) => { const rows = tasks.filter(task => (task.kind === 'Sag') === (key === 'Sag')); const open = rows.filter(task => !/afsluttet|lukket|udført|aflyst|annulleret/i.test(task.status)).length; %><li><a href="<%= listHref({ type: key }) %>"><span class="pb-bar-label"><%= label %><small><%= number(open) %> åbne</small></span><svg class="pb-bar-track" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect class="pb-bar-fill <%= color %>" width="<%= percent(kindCounts[key], kindMax) %>" height="10"></rect></svg><strong><%= number(kindCounts[key]) %></strong></a></li><% }) %></ol>
            <p class="pb-panel-note">Sager er henvendelser i Propbinder og vises som opgaver. API'et sender ikke sagernes titel; den vises fra den opgave, som samme person oprettede op til et minut før sagen. Sag og opgave er to rækker med hver sin status. Sager uden en sådan opgave står som "Sag fra virksomhed".</p>
          </section>
        </div>
        <% } %>
      <% } else { %>
        <section class="panel records-panel" data-filter-scope>
          <div class="panel-heading"><div><p class="eyebrow">OPGAVELISTE</p><h2>Aktuelle opgaver <span class="count-badge" data-filter-count><%= number(tasks.length) %></span></h2></div><span class="read-only-label">Kun læsning</span></div>
          <% if (tasks.length) { %>
            <div class="propbinder-toolbar fox-toolbar">
              <label class="search-wrap"><span>⌕</span><input type="search" data-filter-search value="<%= listFilters.q %>" placeholder="Søg efter opgave, sag, nummer eller ansvarlig" aria-label="Søg opgaver"></label>
              <div class="propbinder-filters">
                <% if (propertyOptions.length > 1) { %><select class="filter-select" data-filter-key="property" aria-label="Filtrér på ejendom"><option value="">Alle ejendomme</option><% propertyOptions.forEach(([name, propertyNumber]) => { %><option value="<%= name %>" <%= listFilters.property === name ? 'selected' : '' %>><%= name %><%= propertyNumber ? ' (' + propertyNumber + ')' : '' %></option><% }) %></select><% } %>
                <select class="filter-select" data-filter-key="status" aria-label="Filtrér på status"><option value="">Alle statusser</option><% statuses.forEach(status => { %><option <%= listFilters.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select>
                <select class="filter-select" data-filter-key="type" aria-label="Type"><option value="">Opgaver og sager</option><option value="Opgave" <%= listFilters.type === 'Opgave' ? 'selected' : '' %>>Kun opgaver (<%= number(kindCounts.Opgave) %>)</option><option value="Sag" <%= listFilters.type === 'Sag' ? 'selected' : '' %>>Kun sager (<%= number(kindCounts.Sag) %>)</option></select>
                <% if (/^\d{4}-\d{2}-\d{2}$/.test(listFilters.dag)) { %><select class="filter-select" data-filter-key="dag" aria-label="Oprettet dag"><option value="">Alle dage</option><option value="<%= listFilters.dag %>" selected>Oprettet <%= dayName(listFilters.dag) %></option></select><% } %>
                <select class="filter-select" data-filter-key="maaned" aria-label="Oprettet i måned"><option value="">Alle måneder</option><% monthOptions.forEach(key => { %><option value="<%= key %>" <%= listFilters.maaned === key ? 'selected' : '' %>>Oprettet <%= monthName(key) %></option><% }) %></select>
                <select class="filter-select" data-filter-key="via" aria-label="Kobling"><option value="">Alle koblinger</option><% viaCounts.forEach(([label]) => { %><option <%= listFilters.via === label ? 'selected' : '' %>><%= label %></option><% }) %></select>
                <button type="button" class="filter-reset" data-filter-reset>Nulstil</button>
              </div>
            </div>
            <div class="table-wrap"><table class="records-table propbinder-table">
              <colgroup><col class="pb-col-task"><% if (showProperty) { %><col class="pb-col-property"><% } %><col class="pb-col-status"><% if (showPriority) { %><col class="pb-col-priority"><% } %><col class="pb-col-date"><col class="pb-col-person"><col class="pb-col-date"></colgroup>
              <thead><tr><th>OPGAVE</th><% if (showProperty) { %><th>EJENDOM</th><% } %><th>STATUS</th><% if (showPriority) { %><th>PRIORITET</th><% } %><th>FRIST</th><th>ANSVARLIG</th><th>OPDATERET</th></tr></thead>
              <tbody><% tasks.forEach(task => { %><tr data-filter-row data-f-status="<%= task.status %>" data-f-property="<%= task.property || '' %>" data-f-via="<%= viaOf(task) %>" data-f-type="<%= task.kind === 'Sag' ? 'Sag' : 'Opgave' %>" data-f-maaned="<%= monthOf(task) %>" data-f-dag="<%= dayOf(task) %>"><td><div class="task-title-cell"><span class="task-id"><% if (task.kind === 'Sag') { %><span class="pb-kind-badge">SAG</span> <%= task.id.replace('SAG-', '') %><%= task.relatedTask ? ' · hører til opgave #' + task.relatedTask.number : '' %><% } else { %><%= /^[0-9]+$/.test(task.id) ? '#' + task.id : task.id %><%= task.relatedCase ? ' · hører til ' + task.relatedCase.replace('SAG-', 'sag ') : '' %><% } %></span><strong><%= task.title %></strong><% if (task.titleFromTask) { %><span class="task-property-meta">Titel og tekst fra opgave #<%= task.relatedTask.number %> (sagen har ingen i API'et)</span><% } %><p><%= task.description ? shorten(task.description) : 'Ingen beskrivelse er tilgængelig.' %></p></div></td><% if (showProperty) { %><td><% if (task.property) { %><strong class="task-property"><%= task.property %></strong><span class="task-property-meta"><%= [task.propertyNumber, task.propertyAddress].filter(Boolean).join(' · ') %></span><% if (task.link) { %><span class="pb-link-badge <%= isText(task) ? 'text' : 'data' %>" title="<%= task.link.evidence ? 'Fundet i opgaven: ' + task.link.evidence : 'Koblet via Propbinders data' %>"><%= viaOf(task) %><%= task.link.evidence ? ': ' + task.link.evidence : '' %></span><% } %><% } else { %>—<% } %></td><% } %><td><span class="record-status status-<%= task.status.toLowerCase().replace(/[^a-zæøå]/g, '') %>"><%= task.status %></span></td><% if (showPriority) { %><td><% if (task.priority) { %><span class="priority-pill priority-<%= String(task.priority).toLowerCase() %>"><%= task.priority %></span><% } else { %>—<% } %></td><% } %><td class="date-cell"><%= formatDate(task.dueDate) %></td><td class="pb-person-cell"><%= task.assignedTo || '—' %></td><td class="date-cell"><%= formatDate(task.updatedAt || task.createdAt) %></td></tr><% }) %></tbody>
            </table></div>
            <div class="empty-state compact" data-filter-empty hidden><strong>Ingen opgaver matcher filtrene</strong></div>
          <% } else { %><div class="empty-state workspace-empty"><span class="empty-icon">☷</span><strong>Der er ingen opgaver at vise</strong><span><%= isLive ? (error ? 'Se fejlen ovenfor.' : 'Propbinder returnerede ingen opgaver.') : 'Testdata er ikke konfigureret.' %></span></div><% } %>
        </section>
      <% } %>
      <footer class="page-footer"><span>© <%= new Date().getFullYear() %> <%= settings.company_name %></span><span>Propbinder integration · read-only</span></footer>
    </section>
  </main>
</body></html>

<% const tabNames = { profil: 'Min profil', brugere: 'Brugere', notifikationer: 'Notifikationer' }; %><%- include('partials/head', { title: tabNames[tab] }) %>
<body class="app-shell"><%- include('partials/sidebar', { user, settings, currentPath }) %><main class="main-content"><header class="topbar"><div class="breadcrumb">Cibus <span>/</span> <a href="/settings">Indstillinger</a> <span>/</span> <strong><%= tabNames[tab] %></strong></div><div class="topbar-date"><span class="status-dot"></span> Dit arbejdsområde</div></header><section class="page-content"><div class="page-heading-row"><div><p class="eyebrow">DIT ARBEJDSOMRÅDE</p><h1>Indstillinger</h1><p class="page-subtitle"><%= isAdmin ? 'Din profil, dine notifikationer og administration af brugere.' : 'Din profil og dine notifikationer. Ændringer gælder kun din egen konto.' %></p></div><span class="settings-emblem">✳</span></div><% if (notice) { %><div class="success-banner"><span>✓</span><%= notice %></div><% } %><% if (error) { %><div class="form-alert"><span>!</span><%= error %></div><% } %><div class="settings-layout"><nav class="settings-nav" aria-label="Indstillingskategorier"><a class="settings-nav-item <%= tab === 'profil' ? 'selected' : '' %>" href="/settings?tab=profil" <%= tab === 'profil' ? 'aria-current="page"' : '' %>><span>◉</span> Min profil</a><% if (isAdmin) { %><a class="settings-nav-item <%= tab === 'brugere' ? 'selected' : '' %>" href="/settings?tab=brugere" <%= tab === 'brugere' ? 'aria-current="page"' : '' %>><span>♙</span> Brugere<% if (settings.user_count) { %> <small class="settings-nav-count"><%= settings.user_count %></small><% } %></a><% } %><a class="settings-nav-item <%= tab === 'notifikationer' ? 'selected' : '' %>" href="/settings?tab=notifikationer" <%= tab === 'notifikationer' ? 'aria-current="page"' : '' %>><span>✉</span> Notifikationer</a></nav><% if (tab === 'brugere') { %><%- include('partials/users-panel', { users, user, roleNames }) %><% } else if (tab === 'notifikationer') { %><%- include('partials/notifications-panel', { notifications, isAdmin }) %><% } else { %><%- include('partials/profile-panel', { profile, isAdmin, settings, roleNames }) %><% } %></div><footer class="page-footer"><span>© <%= new Date().getFullYear() %> <%= settings.company_name %></span><span>En roligere arbejdsdag, sammen.</span></footer></section></main></body></html>

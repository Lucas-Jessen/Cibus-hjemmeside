SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@fokusnordic.dk
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
HOST=127.0.0.1
PORT=3000
# Optional: folder for the database and synced files. Default is ./data. On Azure App Service use /home/data.
# DATA_DIR=/home/data

# SharePoint document copy (keep credentials only in the ignored local .env file)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=store-real-secret-only-in-local-env
SHAREPOINT_DRIVE_ID=your-document-library-drive-id
# Comma-separated SharePoint folder item IDs in the document library
SHAREPOINT_SYNC_FOLDER_IDS=folder-item-id-1,folder-item-id-2
SHAREPOINT_SYNC_INTERVAL_MINUTES=10
SHAREPOINT_MAX_FILE_BYTES=262144000

# Propbinder read-only task integration (Partner API). Keep credentials in the ignored local .env only.
# Set PROPBINDER_MODE=live and the API user to show live tasks; mock shows test data.
PROPBINDER_MODE=mock
PROPBINDER_API_BASE_URL=https://propbinderpartnerapi.azurewebsites.net
PROPBINDER_USERNAME=api-user@example.com
PROPBINDER_PASSWORD=store-secret-only-in-local-env
# Optional readable names for Propbinder status ids: id=Label;id=Label
PROPBINDER_TASK_STATUSES=
# Only show Propbinder tasks on properties in this Excel list (column EjendomNr). Re-read automatically when the file changes.
PROPERTY_LIST_PATH=C:\path\to\Ejendomsliste.xlsx
PROPERTY_LIST_CUSTOMER=Fokus Nordic
# How far back time registrations are read to link tasks to properties.
PROPBINDER_TIMEREG_LOOKBACK_DAYS=1095
# Projekter > Status Fox 1 reads the "FOX 2026" sheet from this workbook. Re-read automatically when the file changes.
FOX_WORKBOOK_PATH=C:\path\to\FOX 2026.xlsm
# Forsikring > Forsikringsskema reads "Forsikringsark", "Sager under afslutning" and "Afsluttet sager" from this workbook.
INSURANCE_WORKBOOK_PATH=C:\path\to\Forsikringsark.xlsm
# Optional: seconds to wait for Propbinder (GetTasks is ~80 MB). Default 90.
PROPBINDER_TIMEOUT_SECONDS=90
# Ejendomme reads Fokus Nordic rows (column Kunde1) from this export of the SharePoint list "Ejendomsoversigt".
PROPERTY_REGISTER_PATH=C:\path\to\FS ejendomsdata udtraek.xlsx
PROPERTY_REGISTER_CUSTOMER=Fokus Nordic
# Vedligeholdsbudgetter reads "Ejendomsoversigt i nr. orden" (rows with Ja under "Udfører FS 10 års DV budget").
DV_STATUS_WORKBOOK_PATH=C:\path\to\DV budget 2027 - Aarshjul.xlsm
# Change notifications (Indstillinger > Notifikationer). Mail is sent through Microsoft Graph as this mailbox;
# the Entra app needs the application permission Mail.Send. NOTIFY_* falls back to the AZURE_* app.
NOTIFY_MAIL_SENDER=portal@example.com
NOTIFY_TENANT_ID=
NOTIFY_CLIENT_ID=
NOTIFY_CLIENT_SECRET=
NOTIFY_INTERVAL_MINUTES=15
PORTAL_BASE_URL=http://127.0.0.1:3000
# Ejendomme from the SharePoint list (uses the AZURE_* app; needs read access to the list). When set, it replaces PROPERTY_REGISTER_PATH.
PROPERTY_REGISTER_SHAREPOINT_SITE=contoso.sharepoint.com:/sites/Ejendomsdrift
PROPERTY_REGISTER_SHAREPOINT_LIST=Ejendomsoversigt
PROPERTY_REGISTER_REFRESH_MINUTES=10
# Optional: only show Propbinder tasks and cases created on or after this date (YYYY-MM-DD). Empty shows all.
PROPBINDER_FROM_DATE=
